# Frontend: only VITE_ variables are exposed to the browser.
# Use your Supabase Cloud project URL: https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Stripe test publishable key for Vercel (pk_test_...).
# The current hosted Checkout flow does not consume this key.
VITE_STRIPE_PUBLISHABLE_KEY=

# Server-only: never prefix secret or service-role keys with VITE_.
# Sync these values to Supabase Cloud Edge Function secrets.
STRIPE_SECRET_KEY=sk_test_replace_me
# Signing secret for the Stripe webhook destination pointing to Supabase Cloud.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# A one-time price created in Stripe test mode.
STRIPE_PRICE_ID=price_replace_me
# Grading uses a separate active one-time SGD 60.00 Stripe test-mode price.
STRIPE_GRADING_FEE_ID=price_replace_me
EMAILJS_SERVICE_ID=
# Instructor login emails and class-cover invitations use an EmailJS template
# with To {{to_email}}, Subject {{email_subject}}, and plain-text Body {{email_body}}.
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
# Optional, if EmailJS requires private-key authorization for REST calls.
EMAILJS_PRIVATE_KEY=
# Phase 2: server-side admin alert for an instructor's class-cover request.
EMAILJS_ADMIN_UNAVAILABILITY_TEMPLATE_ID=
ADMIN_UNAVAILABILITY_EMAIL=suroul29@gmail.com
# Exact frontend origin; used for CORS and Checkout redirect URLs.
APP_URL=http://localhost:5173

# Additional browser origins for staff functions, including instructor chat (comma-separated).
AUTH_ALLOWED_ORIGINS=http://localhost:5173

# Instructor chatbot: server-only OpenRouter credentials. Never use VITE_.
# Create a key at https://openrouter.ai/settings/keys and pick a model that
# supports tool calling: https://openrouter.ai/models?supported_parameters=tools
# Free models end in :free. A comma-separated list (max 3) enables fallback, e.g.
# nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3.5-super-vl:free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Development admin seed only. Never expose these with a VITE_ prefix.
# Supabase supplies the service-role key automatically to deployed functions.
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_SEED_EMAIL=admin@example.test
ADMIN_SEED_PASSWORD=
